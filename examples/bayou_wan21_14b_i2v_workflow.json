{
  "id": "8f4b2e19-6c3a-4d8f-9b12-7e5a3c09d4e1",
  "lora_motion": {
    "class_type": "WanVideoLoraSelectByName",
    "inputs": {
      "lora_name": "wan21/singularunity-wan2.1-motioncraft.safetensors",
      "strength": 0.85,
      "merge_loras": true
    }
  },
  "model_loader": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "wan2.1_i2v_720p_14B_fp8_e4m3fn.safetensors",
      "base_precision": "bf16",
      "quantization": "fp8_e4m3fn",
      "load_device": "offload_device",
      "attention_mode": "sageattn",
      "lora": ["lora_motion", 0]
    }
  },
  "vae_loader": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "wan_2.1_vae.safetensors",
      "precision": "bf16"
    }
  },
  "text_encoder": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "inputs": {
      "model_name": "umt5-xxl-enc-fp8_e4m3fn.safetensors",
      "precision": "bf16",
      "load_device": "offload_device"
    }
  },
  "clip_vision": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "input_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "bayou_master_keyframe.png"
    }
  },
